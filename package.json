{
    "name": "fixed-steps-crash-turn-based-game-service",
    "version": "1.0.0",
    "description": "",
    "main": "./src/app.js",
    "scripts": {
        "integration-test": "jest --config ./jest.integration-test.config.cjs --testPathPattern=tests/integration-tests/ --ci --forceExit --runInBand",
        "test": "jest --testPathPattern=src/ ",
        "test-coverage": "jest --testPathPattern=src/ --collect-coverage",
        "debug": "set APP_NAME=coinmining_service && nodemon --exec tsx ./src/app.js",
        "dev": "set APP_NAME=shooting_blitz_service && nodemon --exec tsx ./src/app.js",
        "prod": "tsx ./src/app.js",
        "reg": "npm set registry http://npm.lumigame.com",
        "stats": "nodemon --exec tsx ./tests/rtp/index.js"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "author": "pentagon",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "chance": "^1.1.7",
        "lodash": "^4.17.19",
        "sc-game-base": "5.5.0",
        "sc-instrument": "1.1.0"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.12.11",
        "@commitlint/cli": "^9.1.2",
        "@commitlint/config-conventional": "^9.1.2",
        "@types/jest": "^29.0.0",
        "babel-jest": "^29.0.0",
        "husky": "^8.0.0",
        "install": "^0.13.0",
        "jest": "^29.0.0",
        "jest-auto-fixture": "^1.0.6",
        "jest-extended": "^3.0.0",
        "jest-junit": "^16.0.0",
        "jest-micro-auto-stub": "^1.0.8",
        "jest-sonar-reporter": "^2.0.0",
        "nodemon": "^2.0.4",
        "sc-game-management-client": "0.1.5",
        "sc-game-service-integration-utils": "^2.1.0",
        "tsx": "^4.20.6"
    },
    "resolutions": {
        "sc-game-base": "5.5.0",
        "mongoose": "6.13.6",
        "form-data": "4.0.4",
        "sc-common": "2.0.0"
    }
}
